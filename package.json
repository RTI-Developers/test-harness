{
  "name": "rti-driver-test-harness",
  "version": "1.0.0",
  "description": "Integration test harness for RTI XP Processor drivers",
  "repository": {
    "type": "git",
    "url":  "https://github.com/RTI-Developers/test-harness.git"
  },
  "homepage": "https://github.com/RTI-Developers/test-harness#readme",
  "main":  "dist/lib/test-harness.js",
  "types": "dist/lib/test-harness.d.ts",
  "exports": {
    ".": {
      "require": "./dist/lib/test-harness.js",
      "default": "./dist/lib/test-harness.js",
      "types":   "./dist/lib/test-harness.d.ts"
    }
  },
  "files": ["dist/lib"],
  "engines": { "node": ">=18" },
  "scripts": {
    "clean":          "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build":          "npm run clean && tsc",
    "prepare":        "npm run build",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "vitest": "^3"
  },
  "devDependencies": {
    "@types/node": "^20",
    "typescript":  "^5",
    "vitest":      "^3"
  }
}
